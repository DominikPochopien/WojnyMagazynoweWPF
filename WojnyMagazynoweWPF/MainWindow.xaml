<Window x:Class="WojnyMagazynoweWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wojny Magazynowe" Height="600" Width="900"
        Background="{StaticResource BrushBg}" FontFamily="Segoe UI">

    <Grid>
        <!-- 1. PANEL LOGOWANIA (Menu) -->
        <Grid x:Name="pnlMenu" Visibility="Visible">
            <Border Width="Auto" MinWidth="340" Height="Auto" CornerRadius="16" Background="{StaticResource BrushPanel}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel Margin="30" VerticalAlignment="Center">
                    <TextBlock Text="📦 WOJNY MAGAZYNOWE" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="Nazwa gracza" FontSize="12" Foreground="{StaticResource BrushSubText}" Margin="2,0,0,4"/>
                    <TextBox x:Name="txtName" Text="Gracz1" Margin="0,0,0,14"/>
                    <TextBlock Text="Adres IP hosta" FontSize="12" Foreground="{StaticResource BrushSubText}" Margin="2,0,0,4"/>
                    <TextBox x:Name="txtIp" Text="127.0.0.1" Margin="0,0,0,20"/>
                    <Button Content="🚀 Hostuj Grę" Height="42" Margin="0,0,0,10" Style="{StaticResource GoodButton}" Click="BtnHost_Click"/>
                    <Button Content="🔗 Dołącz do Gry" Height="42" Click="BtnJoin_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. PANEL GRACZA (Menu po zalogowaniu) -->
        <Grid x:Name="pnlPlayerMenu" Visibility="Hidden" Margin="16">
            <Border CornerRadius="16" Background="{StaticResource BrushPanel}">
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Ellipse Width="46" Height="46" Stroke="White" StrokeThickness="2" Margin="0,0,16,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblPlayerName" Text="Gracz xx" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="lblPlayerBalance" Text="posiadane $ : 10000$" FontSize="15"
                                       Foreground="{StaticResource BrushGold}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Dołącz do aukcji" Height="46" Margin="0,0,0,12" Style="{StaticResource GoodButton}" Click="BtnGoToAuction_Click"/>
                        <Button Content="Sklep/Skup" Height="46" Margin="0,0,0,12" Style="{StaticResource GoldButton}" Click="BtnGoToShop_Click"/>
                        <Button Content="magazyn" Height="46" Style="{StaticResource DangerButton}" Click="BtnGoToStorage_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. GŁÓWNY PANEL AUKCJI -->
        <Grid x:Name="pnlAuction" Visibility="Hidden" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEWA STRONA (Kontrola licytacji) -->
            <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource BrushPanel}">
                <StackPanel Margin="22">
                    <TextBlock x:Name="lblBalance" Text="Twój budżet: 10000$" FontSize="17" FontWeight="Bold"
                               Margin="0,0,0,18" Foreground="{StaticResource BrushGold}"/>

                    <TextBlock Text="Dodaj do oferty:" FontSize="12" Foreground="{StaticResource BrushSubText}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="+1" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+5" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+10" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+25" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+50" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+100" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+200" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+300" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+500" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                        <Button Content="+1000" Style="{StaticResource ChipButton}" Click="BtnAddAmount_Click"/>
                    </WrapPanel>

                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Margin="0,0,0,16" Padding="12">
                        <TextBlock x:Name="lblSelectedAmount" Text="Wybrana kwota: 0$" FontSize="17"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✔ Licytuj" Height="42" Style="{StaticResource GoodButton}" Click="BtnStartBid_Click"/>
                        <Button Grid.Column="2" Content="✖ Wyczyść" Height="42" Style="{StaticResource GhostButton}" Click="BtnResetBid_Click"/>
                    </Grid>

                    <Button Content="PASS (KONIEC)" Height="38" Margin="0,20,0,0" HorizontalAlignment="Left" Width="140"
                            Style="{StaticResource DangerButton}" Click="BtnPass_Click"/>
                </StackPanel>
            </Border>

            <!-- PRAWA STRONA (Informacje o magazynie) -->
            <Border Grid.Column="2" CornerRadius="16" Background="{StaticResource BrushPanel}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="110"/>
                    </Grid.RowDefinitions>

                    <!-- Powinno to wyglądać mniej więcej tak: -->
                    <TextBlock x:Name="lblAuctionHint" Text="Magazyn do licytowania — podpowiedź: posiadał go drwal"
                           FontSize="16" Foreground="{StaticResource BrushSubText}" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="{StaticResource BrushCard}" CornerRadius="12" Margin="0,0,0,12">
                        <Image x:Name="imgAuctionItem" Stretch="Uniform" Margin="10"/>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Historia ofert:" FontSize="12" Foreground="{StaticResource BrushSubText}" Margin="0,0,0,4"/>
                            <ListBox x:Name="listHistory" BorderThickness="0" Background="Transparent" FontSize="14" IsHitTestVisible="False"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource BrushCard}" CornerRadius="10" VerticalAlignment="Center" Padding="10">
                            <StackPanel>
                                <TextBlock Text="OBECNA LICYTACJA" FontSize="12" Foreground="{StaticResource BrushSubText}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblCurrentBid" Text="100$" FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource BrushGold}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. PANEL LISTY MAGAZYNÓW (wygrane aukcje czekające na otwarcie) -->
        <Grid x:Name="pnlWarehouseList" Visibility="Hidden" Margin="0">
            <!-- Rozciągamy na cały ekran: usuwamy MaxWidth, HorizontalAlignment i CornerRadius -->
            <Border Background="{StaticResource BrushPanel}" CornerRadius="0">
                <StackPanel Margin="30">
                    <TextBlock Text="📦 Twoje magazyny" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- ZMIANA: Zastępujemy StackPanel elementem WrapPanel -->
                    <WrapPanel x:Name="stackContainers" Orientation="Horizontal" HorizontalAlignment="Center"/>

                    <!-- Przycisk powrotu na środku -->
                    <Button Content="← Wróć do menu" Height="42" Width="220" Margin="0,40,0,0" 
                            Style="{StaticResource GhostButton}" Click="BtnBackToAuction_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. PANEL MAGAZYNU (Po wygranej, szukanie pudełek) -->
        <Grid x:Name="pnlStorage" Visibility="Hidden" Background="{StaticResource BrushBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblStorageTitle" Text="🏆 Zbadaj magazyn — kliknij pudełka ze znakiem zapytania"
                       Foreground="{StaticResource BrushGold}" FontSize="19" FontWeight="Bold" Margin="20" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Background="{StaticResource BrushPanel}" CornerRadius="14" Margin="20">
                <Canvas x:Name="canvasStorage" Background="Transparent" ClipToBounds="True"/>
            </Border>

            <Button Grid.Row="2" Content="Zabierz łupy i wróć do menu →" Height="48" Width="320" Margin="20"
                    FontSize="16" Style="{StaticResource GoodButton}" Click="BtnLeaveStorage_Click"/>
        </Grid>

        <!-- 5. PANEL SKLEPU (Sprzedaż przedmiotów) -->
        <Grid x:Name="pnlShop" Visibility="Hidden">
            <Border Width="420" CornerRadius="16" Background="{StaticResource BrushPanel}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Text="🏪 TWÓJ SKLEP" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="lblShopBalance" Text="Stan konta: 10000$" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,18" Foreground="{StaticResource BrushGold}"/>

                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="4" Margin="0,0,0,18">
                        <ListBox x:Name="listInventory" Height="200" FontSize="15" Background="Transparent"/>
                    </Border>

                    <Button Content="💰 SPRZEDAJ WSZYSTKO" Height="46" FontSize="16" Style="{StaticResource GoldButton}"
                            Margin="0,0,0,10" Click="BtnSellAll_Click"/>
                    <Button Content="← Wróć do menu" Height="38" Style="{StaticResource GhostButton}" Click="BtnBackToAuction_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
